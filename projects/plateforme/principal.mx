extends Node2D
# Scène principale : compte les pièces ramassées et met à jour l'affichage.

var score = 0
var total = 0
var nom = "Pièces"
@onready var etiquette = $HUD/Score

func _ready():
	var saisi = ProjectSettings.get_setting("jeu/nom_joueur", "")
	if saisi != "":
		nom = saisi
	var pieces = get_tree().get_nodes_in_group("pieces")
	total = pieces.size()
	for piece in pieces:
		piece.ramassee.connect(_sur_piece_ramassee)
	_actualiser()

func _process(_delta):
	if Input.is_action_just_pressed("recommencer"):
		get_tree().reload_current_scene()
	if Input.is_action_just_pressed("menu"):
		get_tree().change_scene_to_file("res://menu.scn")

func _sur_piece_ramassee():
	score += 1
	_actualiser()

func _actualiser():
	if score >= total:
		etiquette.text = "Bravo ! %d / %d" % [score, total]
	else:
		etiquette.text = "%s : %d / %d" % [nom, score, total]
