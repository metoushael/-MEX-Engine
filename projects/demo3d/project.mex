; Projet d'exemple MEX : démonstration 3D (personnage, physique, lumières, ombres).

[application]
name = "Démo 3D"
main_scene = "res://principal.scn"

[display]
width = 960
height = 540

[rendering]
clear_color = Color(0.55, 0.7, 0.9, 1)

[input]
avancer = ["W", "Z", "Up", "JoyLeftY-"]
reculer = ["S", "Down", "JoyLeftY+"]
gauche = ["A", "Q", "JoyLeftX-"]
droite = ["D", "JoyLeftX+"]
camera_gauche = ["Left", "JoyRightX-"]
camera_droite = ["Right", "JoyRightX+"]
sauter = ["Space", "JoyA"]
lancer = ["E", "JoyX"]
recommencer = ["R", "JoyStart"]
quitter = ["Escape", "JoyBack"]
